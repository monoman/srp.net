<Project>
  <PropertyGroup>
      <TargetFramework>net9.0</TargetFramework>
      <Version>1.1.0</Version>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <RootNamespace>SecureRemotePassword</RootNamespace>
      <PackageReleaseNotes>
          What's new:
          - Moved to .NET 9
              + Added build target to 'Publish to Local Nugets Folder' after building library
              + Code now is Nullable compatible (resolved properly most warnings - forced the hand on some few cases)
              + Updated tests to newer NUnit assertion syntax
              + Brought more complete .editorconfig and reformated accordingly          
      </PackageReleaseNotes>
  </PropertyGroup>
</Project>
