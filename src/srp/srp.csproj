<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>SRP-6a protocol implementation for .NET 9.0+</Description>
        <Copyright>Copyright © 2018-2022 Alexey Yakovlev</Copyright>
        <AssemblyTitle>srp</AssemblyTitle>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>$(Version).0</FileVersion>
        <IsPackable>true</IsPackable>
        <Authors>Alexey Yakovlev</Authors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>srp</AssemblyName>
        <PackageId>srp</PackageId>
        <PackageTags>srp;srp-6a;security;authentication</PackageTags>
        <PackageIcon>srp.net.png</PackageIcon>
        <PackageProjectUrl>https://github.com/secure-remote-password/srp.net</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/secure-remote-password/srp.net</RepositoryUrl>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\srp.snk</AssemblyOriginatorKeyFile>
        <DebugType>full</DebugType>
        <RootNamespace>SecureRemotePassword</RootNamespace>
        <DefineConstants>$(DefineConstants);USE_CRYPTO_CONFIG</DefineConstants>
        <CodeAnalysisRuleSet>..\srp.ruleset</CodeAnalysisRuleSet>
        <BaseOutputPath>..\..\bin\</BaseOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\images\srp.net.png" Link="srp.net.png" Pack="true" PackagePath="\" />
        <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.Security" />
        <Using Include="System.Security.Cryptography" />
        <Using Include="System.Text" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Globalization" Version="4.3.0" />
        <PackageReference Include="System.Linq" Version="4.3.0" />
        <PackageReference Include="System.Runtime" Version="4.3.1" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
        <PackageReference Include="System.Runtime.Numerics" Version="4.3.0" />
        <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
    </ItemGroup>
    <Target Name="PublishLocally" AfterTargets="Pack" Condition="Exists('$(NUGET_PACKAGES)')">
        <ItemGroup>
            <NugetPackages Include="$(PackageOutputAbsolutePath)\*$(Version).nupkg" />
        </ItemGroup>
        <Message Importance="high" Text="Publish to Local Nugets Folder '$(NUGET_PACKAGES)'" />
        <Copy DestinationFolder="$(NUGET_PACKAGES)" SourceFiles="@(NugetPackages)" ContinueOnError="true" SkipUnchangedFiles="false">
            <Output TaskParameter="CopiedFiles" PropertyName="CopiedNugets" />
        </Copy>
        <Message Importance="high" Text="Copied '$(CopiedNugets)'" Condition="Exists('$(CopiedNugets)')" />
    </Target>
</Project>
